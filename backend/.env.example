PORT=3000
# Enable only when the public endpoint is protected by verified HTTPS.
ENABLE_HSTS=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=noahs_ark
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
# Local PostgreSQL uses disable; Railway staging uses require.
DB_SSL_MODE=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Local development only. Fake messages stay in memory; no email is sent.
EMAIL_DELIVERY_MODE=disabled